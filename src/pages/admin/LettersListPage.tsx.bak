import { useState } from 'react';
import { useNavigate } from 'react-router-dom';
import { motion, AnimatePresence } from 'framer-motion';
import { ArrowLeft, Search, Plus, Edit2, Trash2, Mail, AlertTriangle } from 'lucide-react';
import { Input } from '@/components/ui/input';
import { Button } from '@/components/ui/button';
import { useTranslation } from 'react-i18next';
import { useContentStore } from '@/store';
import { format } from 'date-fns';

export function LettersListPage() {
  const navigate = useNavigate();
  const { t } = useTranslation('pages');
  const { letters, deleteLetter } = useContentStore();
  const [searchQuery, setSearchQuery] = useState('');
  const [deleteId, setDeleteId] = useState<string | null>(null);

  const filteredLetters = letters.filter(letter =>
    letter.author.toLowerCase().includes(searchQuery.toLowerCase()) ||
    letter.recipient.toLowerCase().includes(searchQuery.toLowerCase())
  );

  const handleDelete = () => {
    if (deleteId) {
      deleteLetter(deleteId);
      setDeleteId(null);
    }
  };

  return (
    <div className="min-h-screen py-12">
      <div className="max-w-[1400px] mx-auto px-4 sm:px-6 lg:px-8 xl:px-12">
        <motion.div
          initial={{ opacity: 0, y: 20 }}
          animate={{ opacity: 1, y: 0 }}
          className="mb-8"
        >
          <Button
            variant="ghost"
            onClick={() => navigate('/admin')}
            className="text-[#6A5D50] hover:text-[#D4C4A0] mb-4"
          >
            <ArrowLeft className="w-4 h-4 mr-2" />
            Назад
          </Button>
          
          <div className="flex items-center justify-between">
            <div>
              <h1 className="text-3xl font-bold text-[#D4C4A0] font-serif flex items-center gap-3">
                <Mail className="w-8 h-8 text-[#8B6914]" />
                Управление письмами
              </h1>
              <p className="text-[#6A5D50] mt-1">{letters.length} записей</p>
            </div>
            <Button className="bg-[#8B6914] text-[#D4C4A0] hover:bg-[#8B6914]/90" onClick={() => navigate('/admin/letters/new')}>
              <Plus className="w-4 h-4 mr-2" />
              Добавить
            </Button>
          </div>
        </motion.div>

        <div className="relative mb-6">
          <Search className="absolute left-4 top-1/2 -translate-y-1/2 w-5 h-5 text-[#B8A080]" />
          <Input
            type="text"
            placeholder="Поиск по автору или адресату..."
            value={searchQuery}
            onChange={(e) => setSearchQuery(e.target.value)}
            className="pl-12 py-6 bg-[#231E15] border-[#3D3225] text-[#D4C4A0] placeholder:text-[#A09080] focus:border-[#8B6914]"
          />
        </div>

        <div className="bg-[#231E15] rounded-lg border border-[#3D3225] overflow-hidden">
          <div className="overflow-x-auto">
            <table className="w-full">
              <thead>
                <tr className="border-b border-[#3D3225]">
                  <th className="text-left px-6 py-4 text-[#6A5D50] text-sm font-medium">Дата</th>
                  <th className="text-left px-6 py-4 text-[#6A5D50] text-sm font-medium">Автор</th>
                  <th className="text-left px-6 py-4 text-[#6A5D50] text-sm font-medium">Адресат</th>
                  <th className="text-left px-6 py-4 text-[#6A5D50] text-sm font-medium">Превью</th>
                  <th className="text-right px-6 py-4 text-[#6A5D50] text-sm font-medium">Действия</th>
                </tr>
              </thead>
              <tbody>
                {filteredLetters.map((letter, index) => (
                  <motion.tr
                    key={letter.id}
                    initial={{ opacity: 0, y: 10 }}
                    animate={{ opacity: 1, y: 0 }}
                    transition={{ delay: index * 0.05 }}
                    className="border-b border-[#3D3225] hover:bg-[#3D3225]/50 transition-colors"
                  >
                    <td className="px-6 py-4 text-[#6A5D50]">
                      {format(letter.date, 'dd.MM.yyyy')}
                    </td>
                    <td className="px-6 py-4 text-[#D4C4A0] font-medium">{letter.author}</td>
                    <td className="px-6 py-4 text-[#6A5D50]">{letter.recipient}</td>
                    <td className="px-6 py-4 text-[#B8A080] text-sm max-w-[300px] truncate">
                      {letter.text.slice(0, 60)}...
                    </td>
                    <td className="px-6 py-4 text-right">
                      <div className="flex items-center justify-end gap-2">
                        <Button variant="ghost" size="icon" className="text-[#6A5D50] hover:text-[#8B6914]">
                          <Edit2 className="w-4 h-4" />
                        </Button>
                        <Button variant="ghost" size="icon" className="text-[#6A5D50] hover:text-[#DC2626]" onClick={() => setDeleteId(letter.id)}>
                          <Trash2 className="w-4 h-4" />
                        </Button>
                      </div>
                    </td>
                  </motion.tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      </div>

      {/* Delete Confirmation Modal */}
      <AnimatePresence>
        {deleteId && (
          <motion.div
            initial={{ opacity: 0 }}
            animate={{ opacity: 1 }}
            exit={{ opacity: 0 }}
            className="fixed inset-0 z-[100] flex items-center justify-center p-4"
            onClick={() => setDeleteId(null)}
          >
            <div className="absolute inset-0 bg-black/70 backdrop-blur-sm" />
            <motion.div
              initial={{ scale: 0.9, opacity: 0 }}
              animate={{ scale: 1, opacity: 1 }}
              exit={{ scale: 0.9, opacity: 0 }}
              className="relative bg-[#231E15] rounded-lg p-8 border border-[#3D3225] max-w-md w-full"
              onClick={(e) => e.stopPropagation()}
            >
              <div className="flex items-center gap-3 mb-6">
                <div className="w-12 h-12 rounded-full bg-[#8B3A3A]/20 flex items-center justify-center">
                  <AlertTriangle className="w-6 h-6 text-[#DC2626]" />
                </div>
                <h2 className="text-xl font-bold text-[#D4C4A0]">Подтвердите удаление</h2>
              </div>
              <p className="text-[#6A5D50] mb-8">
                Вы уверены, что хотите удалить это письмо? Это действие нельзя отменить.
              </p>
              <div className="flex gap-4">
                <Button variant="outline" onClick={() => setDeleteId(null)} className="flex-1 border-[#3D3225] text-[#6A5D50]">
                  Отмена
                </Button>
                <Button onClick={handleDelete} className="flex-1 bg-[#DC2626] hover:bg-[#DC2626]/90">
                  <Trash2 className="w-4 h-4 mr-2" />
                  Удалить
                </Button>
              </div>
            </motion.div>
          </motion.div>
        )}
      </AnimatePresence>
    </div>
  );
}
